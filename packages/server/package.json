{
  "name": "infer-please",
  "type": "module",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "infer-please": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "bun test"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4",
    "@infer-please/tei": "workspace:*",
    "hono": "^4",
    "yaml": "^2",
    "zod": "^3"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^0.2",
    "@infer-please/ai-sdk": "workspace:*",
    "@pleaseai/eslint-config": "latest",
    "ai": "^4",
    "bun-types": "latest",
    "eslint": "^9",
    "openai": "^4",
    "typescript": "^5"
  }
}
