{
  "name": "@pleaseai/infer",
  "type": "module",
  "version": "0.0.0",
  "exports": {
    ".": "./src/index.ts"
  },
  "bin": {
    "infer": "./dist/index.js"
  },
  "scripts": {
    "build": "bun build src/index.ts --outdir dist --target bun",
    "dev": "bun run --watch src/index.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "check-types": "tsc --noEmit",
    "test": "bun test src",
    "test:e2e": "RUN_E2E=1 bun test test/e2e"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4",
    "@pleaseai/infer-tei": "workspace:*",
    "hono": "^4",
    "yaml": "^2",
    "zod": "^4"
  },
  "devDependencies": {
    "@ai-sdk/openai-compatible": "^0.2",
    "@pleaseai/eslint-config": "latest",
    "@pleaseai/infer-ai-sdk": "workspace:*",
    "ai": "^4",
    "bun-types": "latest",
    "eslint": "^9",
    "openai": "^4",
    "typescript": "^6"
  }
}
