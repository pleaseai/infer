{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "lint": {},
    "lint:fix": {},
    "check-types": {},
    "test": {},
    "test:e2e": {
      "cache": false,
      "env": ["RUN_E2E", "CI", "HF_HOME"]
    }
  }
}
